#!/usr/bin/env php
<?php

declare(strict_types=1);

use Blueprint\App;
use Blueprint\Config;
use Blueprint\User;

define("PROJECT_DIR", dirname(__DIR__));

require PROJECT_DIR . "/vendor/autoload.php";

App::create(Config::load(PROJECT_DIR . "/config"));

$usage = <<<TXT
Usage:
  bin/blueprint user:create <email> [role]   creates a user, asks for the password
  bin/blueprint user:password <email|uid>    sets a new password
  bin/blueprint user:list

TXT;

function askPassword(): string
{
    if (getenv("BLUEPRINT_PASSWORD")) {
        return getenv("BLUEPRINT_PASSWORD");
    }

    echo "Password (min. 8 characters): ";
    shell_exec("stty -echo");
    $password = trim((string) fgets(STDIN));
    shell_exec("stty echo");
    echo PHP_EOL;

    return $password;
}

try {
    switch ($argv[1] ?? "") {
        case "user:create":
            $user = User::create($argv[2] ?? "", askPassword(), $argv[3] ?? "user");
            echo "Created {$user->email()} ({$user->uid()})", PHP_EOL;
            break;
        case "user:password":
            $user = User::find($argv[2] ?? "") ?? throw new InvalidArgumentException("User not found");
            $user->changePassword(askPassword());
            echo "Password of {$user->email()} changed", PHP_EOL;
            break;
        case "user:list":
            foreach (User::all() as $user) {
                echo "{$user->uid()}  {$user->email()}  {$user->role()}", PHP_EOL;
            }
            break;
        default:
            echo $usage;
            exit(1);
    }
} catch (Throwable $error) {
    fwrite(STDERR, $error->getMessage() . PHP_EOL);
    exit(1);
}
