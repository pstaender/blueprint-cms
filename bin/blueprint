#!/usr/bin/env php
<?php

declare(strict_types=1);

use Blueprint\App;
use Blueprint\Cli;
use Blueprint\Config;
use Composer\InstalledVersions;

// vendor/bin/blueprint (composer's proxy) sets the autoload path of the website that requires the package
require $_composer_autoload_path ?? dirname(__DIR__) . "/vendor/autoload.php";

// the root package is the website, or this repository when it's not installed as a dependency
define("PROJECT_DIR", realpath(InstalledVersions::getRootPackage()["install_path"]));

App::create(Config::load(PROJECT_DIR . "/config"));

exit(Cli::run($argv));
